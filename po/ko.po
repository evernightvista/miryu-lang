msgid "Usage: miryu-lang <language-code>"
msgstr "사용법: miryu-lang <언어 코드>"

msgid "Examples: miryu-lang zh-cn | miryu-lang en-us | miryu-lang ru | miryu-lang cs"
msgstr "예시: miryu-lang zh-cn | miryu-lang en-us | miryu-lang ru | miryu-lang cs"

msgid "Any language code is accepted; the locale is derived automatically."
msgstr "모든 언어 코드를 지원하며, 로케일은 자동으로 생성됩니다."

msgid "Common shortcuts:"
msgstr "자주 쓰는 단축 코드:"

msgid "Invalid command-line arguments. Type miryu-lang --help for help."
msgstr "명령줄 인수가 올바르지 않습니다. 도움말을 보려면 miryu-lang --help를 입력하십시오."

msgid "Root privileges are required to change the language."
msgstr "언어를 변경하려면 루트 권한이 필요합니다."

msgid ""
"Failed to change language. Please check if the system supports the localectl "
"command and the locale is available."
msgstr "언어 변경에 실패했습니다. 시스템이 localectl 명령을 지원하고 해당 로케일을 사용할 수 있는지 확인하십시오."

#, c-format
msgid "Changed to %s. Restart WSL to apply the changes.\n"
msgstr "%s(으)로 변경되었습니다. WSL을 다시 시작하면 적용됩니다.\n"
